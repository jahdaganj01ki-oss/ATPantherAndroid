<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ATPanther</RootNamespace>
    <AssemblyName>ATPanther</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.1.2</Version>
    <Product>AT Panther</Product>
    <Description>ALDI Talk Datenvolumen-Monitor mit Auto-Nachbuchung (Windows)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- App-Icon zusätzlich als Ressource einbetten (für Tray-Icon/Form-Icon im Single-File-Build) -->
    <EmbeddedResource Include="assets\app.ico" LogicalName="ATPanther.assets.app.ico" />
  </ItemGroup>

</Project>
