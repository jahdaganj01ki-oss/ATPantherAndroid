<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hintergrundprozess fuer EMUI (Huawei AGS2-L09 / Android 8): Wakelock als Fallback -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Bypass fuer aggressives Batterie-Management – oeffnet Whitelist-Dialog -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- AlarmManager-Fallback fuer Intervall-Polling trotz Doze/Standby -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".PantherApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ATPanther.Black"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
          Freeze-Fix-Optimierung (aus der X11Pro-Variante):
           - launchMode=singleTask: erneutes Oeffnen (Launcher oder Notification)
             bring die laufende Instanz nach vorn, statt eine zweite Activity zu
             stapeln (typische Freeze-/Lag-Quelle nach laengerer Laufzeit).
           - configChanges: Drehen baut die Activity nicht neu auf. Die UI-Elements
             halten ihren Zustand, der Monitor-Service laeuft unabhaengig weiter.
             Spart die komplette Re-Inflation samt RecyclerView-Neuaufbau
             beim Drehen (auch auf Mittelklasse-SoCs wie dem Snapdragon 720G).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.MonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          WakeLock-Fallback-Empfaenger: AlarmManager kann via getBroadcast() den
          Receiver ansprechen – dieser startet den [MonitorService] neu,
          damit EMUI den Monitor nicht beendet.
        -->
        <receiver
            android:name=".service.MonitorWakeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.alditalk.panther.RESTART_MONITOR" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
