<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ATPanther</RootNamespace>
    <AssemblyName>AT Panther</AssemblyName>
    <ApplicationIcon>assets\app.ico</ApplicationIcon>
    <Version>1.1.0</Version>
    <Product>AT Panther</Product>
    <AssemblyTitle>AT Panther</AssemblyTitle>
    <!-- Identitaet der Android-Vorlage: com.alditalk.panther, versionName 1.1 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DebugType>portable</DebugType>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Update="assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
