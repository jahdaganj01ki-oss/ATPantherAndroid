<Window x:Class="ATPanther.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AT Panther" Height="860" Width="520"
        MinHeight="640" MinWidth="460"
        Icon="pack://application:,,,/Assets/icon.ico"
        Background="#000000" Foreground="#FFFFFF">
  <!--
    v1.6: Alles auf EINER Seite (kein TabControl mehr), untereinander in einem
    ScrollViewer. Reihenfolge bewusst so gewaehlt:
    1. Monitor-Freigabe  -> beantwortet sofort "wer ist aktiv?"
    2. Login-Daten
    3. Monitor
    4. Verlauf (feste Hoehe, damit die Liste intern scrollt)
  -->
  <Grid Margin="12">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Vertical">

          <!-- Monitor-Freigabe: nur eine Variante darf das Portal abfragen,
               damit Windows und Moto G84 nicht parallel denselben Login pollen.
               Steht bewusst ganz oben - das ist die wichtigste Info im Fenster. -->
          <GroupBox Header="Monitor-Freigabe (nur eine Variante fragt ab)" Foreground="#E0E0E0" Margin="0,0,0,8">
            <StackPanel Margin="8">
              <TextBlock x:Name="TvLock" Text="Freigabe: unbekannt" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <Button x:Name="BtnLockClaim" Content="Auf diesem Gerät übernehmen" Background="#9E9E9E" Foreground="#000000" Padding="8" Margin="0,0,6,0" Click="OnLockClaimClicked"/>
                <Button x:Name="BtnLockRelease" Content="Freigeben" Background="#9E9E9E" Foreground="#000000" Padding="8" Click="OnLockReleaseClicked"/>
              </StackPanel>
              <TextBlock Text="Einstellungen (nur beim ersten Mal nötig):" Foreground="#808080" FontSize="11" Margin="0,6,0,2"/>
              <Label Content="URL des Cloudflare Workers" Foreground="#B0B0B0"/>
              <TextBox x:Name="EtLockUrl" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
              <Label Content="Token (nur falls gesetzt)" Foreground="#B0B0B0" Margin="0,8,0,0"/>
              <TextBox x:Name="EtLockToken" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
              <CheckBox x:Name="ChkFailOpen" Content="Bei Server-Ausfall weiterlaufen (nicht empfohlen)" Foreground="#B0B0B0" Margin="0,8,0,0"/>
              <Button x:Name="BtnLockSave" Content="Freigabe speichern" Background="#9E9E9E" Foreground="#000000" Padding="8" Margin="0,8,0,0" Click="OnLockSaveClicked"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Login-Daten + Einstellungen" Foreground="#E0E0E0" Margin="0,0,0,8">
            <StackPanel Margin="8">
              <Label Content="Rufnummer" Foreground="#B0B0B0"/>
              <TextBox x:Name="EtPhone" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
              <Label Content="Passwort" Foreground="#B0B0B0" Margin="0,8,0,0"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <PasswordBox x:Name="EtPassword" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
                <TextBox x:Name="EtPasswordVisible" Visibility="Collapsed" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
                <Button x:Name="BtnEye" Grid.Column="1" Content="👁" Width="40" Margin="6,0,0,0" Click="OnEyeClicked"/>
              </Grid>
              <Label Content="Schwelle (MB)" Foreground="#B0B0B0" Margin="0,8,0,0"/>
              <TextBox x:Name="EtThreshold" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
              <Label Content="Intervall (Sekunden)" Foreground="#B0B0B0" Margin="0,8,0,0"/>
              <TextBox x:Name="EtInterval" Background="#2A2A2A" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Padding="6"/>
              <Button x:Name="BtnSave" Content="Anmeldedaten speichern" Background="#9E9E9E" Foreground="#000000" Padding="8" Margin="0,12,0,0" Click="OnSaveClicked"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Monitor" Foreground="#E0E0E0" Margin="0,0,0,8">
            <StackPanel Margin="8">
              <TextBlock x:Name="TvStatus" Text="Gestoppt" Foreground="#B0B0B0" TextWrapping="Wrap" Margin="0,0,0,8"/>
              <Button x:Name="BtnToggle" Content="Monitor starten" Background="#9E9E9E" Foreground="#000000" Padding="8" Click="OnToggleClicked"/>
              <CheckBox x:Name="ChkAutostart" Content="Autostart mit Windows" Foreground="#B0B0B0" Margin="0,8,0,0" Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
              <Button x:Name="BtnClearHistory" Content="Verlauf löschen" Background="#9E9E9E" Foreground="#000000" Padding="8" Margin="0,8,0,0" Click="OnClearClicked"/>
            </StackPanel>
          </GroupBox>

          <GroupBox Header="Verlauf" Foreground="#E0E0E0" Margin="0,0,0,8">
        <Grid Margin="8">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <!-- Feste Hoehe: ein ListBox, das seine Hoehe aus dem ScrollViewer
               bezieht, misst alle Eintraege neu und blockiert die UI. -->
          <ListBox x:Name="RvLog" Background="#141414" Foreground="#FFFFFF" BorderBrush="#8A8A8A" Height="240"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnExport" Content="Export" Background="#9E9E9E" Foreground="#000000" Padding="8" Margin="0,0,8,0" Click="OnExportClicked"/>
            <Button x:Name="BtnClear" Content="Cache löschen" Padding="8" Margin="0,0,8,0" Click="OnClearClicked"/>
            <Button x:Name="BtnOpenLog" Content="📄 Logdatei öffnen" Padding="8" Click="OnOpenLogClicked"/>
          </StackPanel>
          <TextBlock Grid.Row="2" Text="Umschalten: in beiden Varianten auf „Übernehmen“ tippen – die andere geht dann automatisch in den Bereitschaftsmodus." Foreground="#808080" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"/>
        </Grid>
      </GroupBox>

    </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
