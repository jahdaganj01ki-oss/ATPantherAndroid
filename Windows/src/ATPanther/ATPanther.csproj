<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ATPanther</AssemblyName>
    <RootNamespace>ATPanther</RootNamespace>
    <VersionPrefix>1.5</VersionPrefix>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icon als Resource einbetten (Single-File-safe): Das Artifact enthaelt nur
         die .exe, daneben liegende Content-Dateien fehlen zur Laufzeit und das
         XAML-Icon ("Assets/icon.ico") liess den Start mit XamlParseException
         krachen (Fix 27.09.2026). -->
    <Resource Include="Assets\icon.ico" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
