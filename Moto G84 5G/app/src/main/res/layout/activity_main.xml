<?xml version="1.0" encoding="utf-8"?>
<!--
  MotoG84 v1.6: EINE Seite fuer alles (kein ViewPager2, keine Tabs mehr).
  Der komplette Inhalt - Freigabe, Login, Monitor und Verlauf - steht in einem
  ScrollView untereinander. Schon beim Oeffnen sichtbar ist die wichtigste
  Info: welche Variante gerade das Portal abfragt.

  Der Verlauf sitzt als RecyclerView mit FESTER Hoehe darin (kein 0dp/weight):
  eine Liste mit unbegrenzter Hoehe in einem ScrollView misst alle Zeilen bei
  jedem Layout-Durchlauf, das Recycling faellt aus und die 120-Hz-pOLED des
  Moto G84 ruckelt bzw. friert ein. Mit fester Hoehe scrollt die Liste intern.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black">

    <ScrollView
        android:id="@+id/scrollRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:id="@+id/containerMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>
</FrameLayout>

