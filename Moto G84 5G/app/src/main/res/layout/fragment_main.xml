<?xml version="1.0" encoding="utf-8"?>
<!-- MotoG84 v1.6: Die EINE Seite – Freigabe (oben), Login-Daten, Monitor,
     Verlauf und Wartung untereinander in einem ScrollView.
     Freigabe steht bewusst oben: sie beantwortet sofort die Frage
     "fragt gerade ich ab oder die andere Variante?". -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="@color/bg_black">

    <!-- ── Monitor-Freigabe (v1.6 neu: direkt sichtbar, mit Umschalt-Buttons) ── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor-Freigabe"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <!-- Statuszeile: zeigt an, welche Variante aktiv ist. -->
            <TextView
                android:id="@+id/tvLockStatusInline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Freigabe: unbekannt"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLockClaimInline"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/lock_claim_here"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    app:backgroundTint="@color/button_filled_gray"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLockReleaseInline"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:minHeight="40dp"
                    android:text="@string/lock_release"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Weitere Einstellungen (URL/Token) bleiben im Dialog. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLockSettings"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_marginTop="2dp"
                android:text="@string/lock_settings_open"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AT Panther"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginBottom="4dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Login-Daten"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="2dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input"
                android:hint="Rufnummer (z.B. 491637805298)"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textCursorDrawable="@null"
                android:textSelectHandle="@drawable/text_select_handle"
                android:textSelectHandleLeft="@drawable/text_select_handle"
                android:textSelectHandleRight="@drawable/text_select_handle"
                android:inputType="phone"
                android:maxLines="1"
                android:singleLine="true" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input"
                    android:hint="Passwort"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textCursorDrawable="@null"
                    android:textSelectHandle="@drawable/text_select_handle"
                    android:textSelectHandleLeft="@drawable/text_select_handle"
                    android:textSelectHandleRight="@drawable/text_select_handle"
                    android:inputType="textPassword"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:paddingEnd="48dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTogglePassword"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_visibility"
                    app:iconSize="22dp"
                    app:iconTint="@color/text_secondary"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    android:contentDescription="Passwort anzeigen"
                    android:text="" />

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Einstellungen"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Schwelle (MB):"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etThreshold"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:gravity="end"
                    android:inputType="numberDecimal"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Intervall (Sek.):"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <EditText
                    android:id="@+id/etInterval"
                    android:layout_width="100dp"
                    android:layout_height="40dp"
                    android:gravity="end"
                    android:inputType="number"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:singleLine="true" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCredentials"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:layout_marginTop="4dp"
                android:text="Speichern"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                app:backgroundTint="@color/button_filled_gray"
                app:cornerRadius="18dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monitor"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Gestoppt"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnToggleMonitor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:text="@string/monitor_start"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true"
                app:backgroundTint="@color/button_filled_gray"
                app:cornerRadius="20dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatteryOpt"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:text="Akku-Schutz"
                    android:contentDescription="Batterie-Optimierung ignorieren"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:singleLine="true" />

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ── Verlauf (v1.6: von der zweiten Seite hierher gezogen) ────────────── -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/card_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verlauf"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <!-- FESTE Hoehe, nicht 0dp/weight: im ScrollView wuerde der
                 RecyclerView sonst alle 200 Zeilen messen (kein Recycling)
                 und die UI einfrieren. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLog"
                android:layout_width="match_parent"
                android:layout_height="260dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wartung"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearCache"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="Cache leeren"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportLog"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="36dp"
                android:text="Log exportieren"
                android:textSize="12sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:singleLine="true" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>


